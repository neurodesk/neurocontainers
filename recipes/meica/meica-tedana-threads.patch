+def _n_threads():
+    try:
+        return max(1, int(os.environ.get("OMP_NUM_THREADS", "")))
+    except ValueError:
+        return os.cpu_count() or 1
+
+
+def _row_blocked(g, executor, n_blocks):
+    """Apply a row-wise FastICA nonlinearity to row blocks in parallel.
+
+    numpy releases the GIL in ufuncs, and each row is computed exactly as in
+    the serial call, so results are bit-identical.
+    """
+    if executor is None or g not in _ROW_WISE_NONLINEARITIES:
+        return g
+
+    def blocked(x, fun_args):
+        bounds = np.linspace(0, x.shape[0], n_blocks + 1).astype(int)
+        gx = np.empty_like(x)
+        g_x = np.empty(x.shape[0], dtype=x.dtype)
+
+        def run(start, stop):
+            gx[start:stop], g_x[start:stop] = g(x[start:stop], fun_args)
+
+        list(executor.map(run, bounds[:-1], bounds[1:]))
+        return gx, g_x
+
+    return blocked
+
+
