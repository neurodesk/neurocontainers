#!/usr/bin/env Rscript
usage <- "Usage: alpaca --t1 T1.nii.gz --flair FLAIR.nii.gz --epi EPI.nii.gz --phase PHASE.nii.gz --output DIR [options]

Runs ALPaCA preprocessing (N4, rigid registration to EPI space, brain
extraction, MIMoSA lesion candidates) followed by lesion, paramagnetic rim
lesion (PRL) and central vein sign (CVS) prediction.

Options:
  --brain-mask FILE        Brain mask in EPI space (default: FSL BET on T1)
  --cores N                CPU cores for MIMoSA (default: 1)
  --lesion-priority P      youden | specificity | sensitivity (default: youden)
  --prl-priority P         youden | specificity | sensitivity (default: youden)
  --cvs-priority P         youden | specificity | sensitivity (default: youden)
  --n-patches N            Patches sampled per lesion candidate (default: 25)
  --raw-probabilities      Also write lesion_prob, prl_prob and cvs_prob images
  --verbose                Print progress from each step
  -h, --help               Show this help

Outputs in DIR: preprocessed *_final.nii.gz, prob.nii.gz,
labeled_candidates.nii.gz, alpaca_mask.nii.gz, predictions.csv and
probabilities.csv. alpaca_mask values: 1 lesion, 3 lesion+PRL,
5 lesion+CVS, 7 lesion+PRL+CVS.
"

args <- commandArgs(trailingOnly = TRUE)
if (length(args) == 0 || any(args %in% c("-h", "--help"))) {
  cat(usage)
  quit(status = if (length(args) == 0) 1 else 0)
}

flags <- c("--raw-probabilities", "--verbose")
valued <- c("--t1", "--flair", "--epi", "--phase", "--output", "--brain-mask",
            "--cores", "--lesion-priority", "--prl-priority", "--cvs-priority",
            "--n-patches")
opts <- list()
i <- 1
while (i <= length(args)) {
  key <- args[[i]]
  if (key %in% flags) {
    opts[[key]] <- TRUE
    i <- i + 1
  } else if (key %in% valued && i < length(args)) {
    opts[[key]] <- args[[i + 1]]
    i <- i + 2
  } else {
    cat(usage, file = stderr())
    stop("unknown or incomplete argument: ", key, call. = FALSE)
  }
}

missing <- setdiff(c("--t1", "--flair", "--epi", "--phase", "--output"), names(opts))
if (length(missing) > 0) {
  cat(usage, file = stderr())
  stop("missing required arguments: ", paste(missing, collapse = " "), call. = FALSE)
}

priority <- function(key) {
  value <- tolower(if (is.null(opts[[key]])) "youden" else opts[[key]])
  choices <- c(youden = "Youden's J", specificity = "Specificity",
               sensitivity = "Sensitivity")
  if (!value %in% names(choices)) {
    stop(key, " must be one of: ", paste(names(choices), collapse = ", "), call. = FALSE)
  }
  choices[[value]]
}

verbose <- isTRUE(opts[["--verbose"]])
output_dir <- opts[["--output"]]
dir.create(output_dir, showWarnings = FALSE, recursive = TRUE)

suppressPackageStartupMessages(library(ALPaCA))

images <- preprocess_images(
  t1_path = opts[["--t1"]],
  flair_path = opts[["--flair"]],
  epi_path = opts[["--epi"]],
  phase_path = opts[["--phase"]],
  output_dir = output_dir,
  brain_mask_path = opts[["--brain-mask"]],
  cores = if (is.null(opts[["--cores"]])) 1L else as.integer(opts[["--cores"]]),
  verbose = verbose
)

result <- make_predictions(
  ants_list = images,
  output_dir = output_dir,
  lesion_priority = priority("--lesion-priority"),
  prl_priority = priority("--prl-priority"),
  cvs_priority = priority("--cvs-priority"),
  return_raw_probabilities = isTRUE(opts[["--raw-probabilities"]]),
  n_patches = if (is.null(opts[["--n-patches"]])) 25L else as.integer(opts[["--n-patches"]]),
  verbose = verbose
)

if (is.null(result)) {
  message("No lesion candidates detected; preprocessed images written to ", output_dir)
} else {
  counts <- colSums(result$predictions)
  message(sprintf("ALPaCA finished: %d lesions, %d PRL, %d CVS. Results in %s",
                  counts[[1]], counts[[2]], counts[[3]], output_dir))
}
