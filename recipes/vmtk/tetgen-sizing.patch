+public:
+  SizedSurface(vtkUnstructuredGrid& input, vtkDataArray* lengths)
+  {
+    const int count = NativeCount(input.GetNumberOfPoints());
+    const int cellCount = NativeCount(input.GetNumberOfCells());
+    Require(count >= 4 && cellCount >= 4, "Sizing needs a closed triangular surface.");
+    Require(lengths && lengths->GetNumberOfComponents() == 1 &&
+            lengths->GetNumberOfTuples() == count,
+            "Sizing needs exactly one scalar length per input point.");
+    std::set<Coordinate> coordinates;
+    for (int i = 0; i < count; ++i)
+      {
+      LengthSample sample;
+      input.GetPoint(i, sample.position.data());
+      sample.length = lengths->GetComponent(i, 0);
+      Require(std::all_of(sample.position.begin(), sample.position.end(),
+                         [](REAL x) { return std::isfinite(x); }),
+              "Sizing coordinates must be finite.");
+      Require(std::isfinite(sample.length) && sample.length > 0,
+              "Sizing lengths must be finite and positive.");
+      Require(coordinates.insert(sample.position).second,
+              "Sizing coordinates must be unique.");
+      this->Samples.push_back(sample);
+      }
+    std::vector<bool> used(count, false);
+    using Edge = std::pair<int, int>;
+    std::map<Edge, std::vector<std::pair<int, int>>> edges;
+    for (int i = 0; i < cellCount; ++i)
+      {
+      Require(input.GetCellType(i) == VTK_TRIANGLE,
+              "Sizing accepts only triangular surface cells.");
+      vtkIdType size;
+      const vtkIdType* ids;
+      input.GetCellPoints(i, size, ids);
+      Require(size == 3, "Sizing facet is not a triangle.");
+      Face face;
+      for (int k = 0; k < 3; ++k)
+        {
+        Require(ids[k] >= 0 && ids[k] < count, "Sizing facet index is invalid.");
+        face[k] = static_cast<int>(ids[k]);
+        used[face[k]] = true;
+        }
+      Require(face[0] != face[1] && face[1] != face[2] && face[2] != face[0],
+              "Sizing facet repeats a vertex.");
+      const auto& a = this->Samples[face[0]].position;
+      const auto& b = this->Samples[face[1]].position;
+      const auto& c = this->Samples[face[2]].position;
+      long double area = 0;
+      for (int k = 0; k < 3; ++k)
+        {
+        const int j = (k+1)%3, l = (k+2)%3;
+        long double cross = (static_cast<long double>(b[j])-a[j]) *
+                            (static_cast<long double>(c[l])-a[l]) -
+                            (static_cast<long double>(b[l])-a[l]) *
+                            (static_cast<long double>(c[j])-a[j]);
+        area += cross*cross;
+        }
+      Require(std::isfinite(area) && area > 0, "Sizing facet has zero area.");
+      this->Faces.push_back(face);
+      for (int k = 0; k < 3; ++k)
+        {
