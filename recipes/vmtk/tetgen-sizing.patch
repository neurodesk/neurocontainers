+namespace
+{
+using Coordinate = std::array<REAL, 3>;
+using Face = std::array<int, 3>;
+
+void Require(bool condition, const char* message)
+{
+  if (!condition) throw std::runtime_error(message);
+}
+
+int NativeCount(vtkIdType count)
+{
+  Require(count >= 0 && count <= std::numeric_limits<int>::max() / 10,
+          "Mesh count exceeds the native allocation/index range.");
+  return static_cast<int>(count);
+}
+
+bool PositiveOrientation(Coordinate a, Coordinate b, Coordinate c, Coordinate d)
+{
+  long double u[3], v[3], w[3];
+  for (int k = 0; k < 3; ++k)
+    {
+    u[k] = static_cast<long double>(b[k]) - a[k];
+    v[k] = static_cast<long double>(c[k]) - a[k];
+    w[k] = static_cast<long double>(d[k]) - a[k];
+    }
+  const long double terms[] = {u[0]*v[1]*w[2], u[1]*v[2]*w[0],
+    u[2]*v[0]*w[1], -u[0]*v[2]*w[1], -u[1]*v[0]*w[2], -u[2]*v[1]*w[0]};
+  long double value = 0, magnitude = 0;
+  for (long double term : terms)
+    {
+    value += term;
+    magnitude += std::abs(term);
+    }
+  // Each term has three subtractions and two products; summation adds five
+  // operations. Coordinates are the represented doubles, not guessed reals.
+  const long double uRound = std::numeric_limits<long double>::epsilon();
+  const long double error = (16*uRound/(1-16*uRound))*magnitude;
+  if (std::isfinite(value) && std::isfinite(error) && std::abs(value) > error)
+    return value > 0;
+
+  // tetrahedralize initializes the predicates before either publication check.
+  // orient3d has the opposite sign to the VTK tetrahedral determinant.
+  const REAL orientation = orient3d(a.data(), b.data(), c.data(), d.data());
+  return std::isfinite(orientation) && orientation < 0;
+}
+
+std::vector<Coordinate> NativePoints(const tetgenio& data)
+{
+  Require(data.numberofpoints > 0 && data.pointlist,
+          "TetGen returned no points.");
+  NativeCount(data.numberofpoints);
+  std::vector<Coordinate> points(data.numberofpoints);
+  for (int i = 0; i < data.numberofpoints; ++i)
+    for (int k = 0; k < 3; ++k)
+      {
+      points[i][k] = data.pointlist[3*i+k];
+      Require(std::isfinite(points[i][k]), "TetGen returned a nonfinite point.");
+      }
+  return points;
+}
+
+std::vector<bool> ValidateVolume(const tetgenio& data)
+{
+  auto points = NativePoints(data);
+  Require(data.numberoftetrahedra > 0 && data.numberofcorners == 4 &&
+          data.tetrahedronlist, "TetGen returned no linear tetrahedral core.");
+  NativeCount(data.numberoftetrahedra);
+  std::vector<bool> incident(points.size(), false);
+  for (int i = 0; i < data.numberoftetrahedra; ++i)
+    {
+    int ids[4];
+    for (int k = 0; k < 4; ++k)
+      {
+      ids[k] = data.tetrahedronlist[4*i+k];
+      Require(ids[k] >= 0 && ids[k] < data.numberofpoints,
+              "TetGen returned an invalid tetrahedral index.");
+      incident[ids[k]] = true;
+      }
+    Require(PositiveOrientation(points[ids[0]], points[ids[1]],
+                                points[ids[2]], points[ids[3]]),
+            "TetGen returned an inverted or unresolved tetrahedron.");
+    }
+  return incident;
+}
