+      const auto a = edge.second[0], b = edge.second[1];
+      neighbors[a.first].push_back({b.first, -a.second*b.second});
+      neighbors[b.first].push_back({a.first, -a.second*b.second});
+      }
+    std::vector<int> orientation(cellCount, 0), queue{0};
+    orientation[0] = 1;
+    for (size_t i = 0; i < queue.size(); ++i)
+      for (const auto& neighbor : neighbors[queue[i]])
+        {
+        const int direction = orientation[queue[i]]*neighbor.second;
+        if (!orientation[neighbor.first])
+          {
+          orientation[neighbor.first] = direction;
+          queue.push_back(neighbor.first);
+          }
+        Require(orientation[neighbor.first] == direction,
+                "Sizing surface is not orientable.");
+        }
+    Require(queue.size() == this->Faces.size(),
+            "Sizing supports one connected shell; cavity shells need hole seeds.");
+    for (int i = 0; i < cellCount; ++i)
+      if (orientation[i] < 0) std::swap(this->Faces[i][1], this->Faces[i][2]);
+    this->CheckEmbedding();
+  }
+
+  std::vector<LengthSample> Samples;
+  std::vector<Face> Faces;
+
+private:
+  void CheckEmbedding() const
+  {
+    tetgenmesh predicates;
+    predicates.macheps = exactinit();
+    for (size_t i = 0; i < this->Faces.size(); ++i)
+      for (size_t j = i+1; j < this->Faces.size(); ++j)
+        {
+        const auto& a = this->Faces[i];
+        const auto& b = this->Faces[j];
+        bool separated = false;
+        for (int k = 0; k < 3; ++k)
+          {
+          REAL amin = this->Samples[a[0]].position[k], amax = amin;
+          REAL bmin = this->Samples[b[0]].position[k], bmax = bmin;
+          for (int l = 1; l < 3; ++l)
+            {
+            amin = std::min(amin, this->Samples[a[l]].position[k]);
+            amax = std::max(amax, this->Samples[a[l]].position[k]);
+            bmin = std::min(bmin, this->Samples[b[l]].position[k]);
+            bmax = std::max(bmax, this->Samples[b[l]].position[k]);
+            }
+          separated |= amax < bmin || bmax < amin;
+          }
+        if (separated) continue;
+        int shared = 0;
+        for (int x : a) for (int y : b) shared += x == y;
+        Require(shared < 3, "Sizing surface contains duplicate facets.");
+        Coordinate p[6];
+        for (int k = 0; k < 3; ++k)
+          {
+          p[k] = this->Samples[a[k]].position;
+          p[k+3] = this->Samples[b[k]].position;
+          }
+        const auto intersection = predicates.tri_tri_inter(p[0].data(),
+          p[1].data(), p[2].data(), p[3].data(), p[4].data(), p[5].data());
+        const auto expected = shared == 2 ? tetgenmesh::SHAREEDGE :
+          shared == 1 ? tetgenmesh::SHAREVERTEX : tetgenmesh::DISJOINT;
+        Require(intersection == expected, "Sizing surface has intersecting facets.");
+        }
+  }
+};
+
+class ScalarBackground final
+{
+public:
+  ScalarBackground(const SizedSurface& surface, double epsilon)
+  {
+    tetgenio cloud;
+    cloud.firstnumber = 0;
+    cloud.numberofpoints = NativeCount(surface.Samples.size());
+    cloud.pointlist = new REAL[3*cloud.numberofpoints];
+    std::map<Coordinate, REAL> lengths;
+    for (int i = 0; i < cloud.numberofpoints; ++i)
+      {
+      const auto& sample = surface.Samples[i];
+      std::copy(sample.position.begin(), sample.position.end(), cloud.pointlist+3*i);
+      lengths.emplace(sample.position, sample.length);
+      }
+    char options[64];
+    std::snprintf(options, sizeof(options), "T%ezQ", epsilon);
+    tetrahedralize(options, &cloud, &this->Data, nullptr, nullptr);
+    auto incident = ValidateVolume(this->Data);
+    Require(this->Data.numberofpoints == cloud.numberofpoints,
+            "Background seed lost or added a sizing sample.");
+    this->Data.numberofpointmtrs = 1;
+    this->Data.pointmtrlist = new REAL[this->Data.numberofpoints];
+    auto points = NativePoints(this->Data);
+    for (int i = 0; i < this->Data.numberofpoints; ++i)
+      {
+      const auto found = lengths.find(points[i]);
+      Require(found != lengths.end() && incident[i],
+              "Background seed moved, repeated, or isolated a sizing sample.");
+      this->Data.pointmtrlist[i] = found->second;
+      lengths.erase(found);
+      }
+    Require(lengths.empty(), "Background seed omitted a sizing sample.");
+  }
+  ScalarBackground(const ScalarBackground&) = delete;
+  ScalarBackground& operator=(const ScalarBackground&) = delete;
+  tetgenio* NativeInput() { return &this->Data; }
+private:
+  tetgenio Data;
+};
+}
 
