set(BLA_VENDOR OpenBLAS)
include("${CMAKE_ROOT}/Modules/FindBLAS.cmake")
if(NOT TARGET BLAS::BLAS)
  message(FATAL_ERROR "The explicit OpenBLAS provider did not create BLAS::BLAS")
endif()
get_target_property(provider_libraries BLAS::BLAS INTERFACE_LINK_LIBRARIES)
if(NOT "${provider_libraries}" STREQUAL "${BLAS_openblas_LIBRARY}")
  message(FATAL_ERROR "Unexpected BLAS provider: ${provider_libraries}")
endif()
