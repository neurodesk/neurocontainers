#!/usr/bin/env bash
set -euo pipefail

PG_MAJOR="18"
PG_BIN="/usr/lib/postgresql/${PG_MAJOR}/bin"
export PATH="${PG_BIN}:/usr/local/bin:/usr/bin:/bin:${PATH:-}"

PGANALYTICS_DATA="${PGANALYTICS_DATA:-${HOME:-/tmp}/pg-analytics}"
if [ -z "${PGANALYTICS_RUN:-}" ]; then
  PGANALYTICS_DATA_CANONICAL=$(realpath -m -- "$PGANALYTICS_DATA")
  PGANALYTICS_DATA_HASH=$(printf '%s' "$PGANALYTICS_DATA_CANONICAL" | sha256sum | cut -c1-12)
  PGANALYTICS_RUN="/tmp/pg-analytics-$(id -u)-${PGANALYTICS_DATA_HASH}"
fi
PGANALYTICS_HOST="${PGANALYTICS_HOST:-127.0.0.1}"
PGANALYTICS_PORT="${PGANALYTICS_PORT:-5433}"
PGANALYTICS_DB="${PGANALYTICS_DB:-postgres}"
PGANALYTICS_PRELOAD="${PGANALYTICS_PRELOAD:-pg_stat_statements,timescaledb,pgedge_vectorizer}"
PGANALYTICS_LOG="${PGANALYTICS_LOG:-${PGANALYTICS_DATA}/postgresql.log}"

usage() {
  cat <<EOF
Usage: pg-analytics <command> [args...]

Manage a user-space PostgreSQL ${PG_MAJOR} analytics cluster (safe for read-only
Apptainer/Lmod containers and non-root sessions such as scidesktop/aidesktop).

Commands:
  init                       Initialize cluster in PGANALYTICS_DATA
  start [--foreground]       Start PostgreSQL; keep Apptainer open in foreground mode
  stop                       Stop PostgreSQL server cleanly
  status                     Show server status and connection parameters
  psql [psql-args...]        Open psql connected to this cluster
  enable-extensions [db]     Enable all bundled analytics extensions in target database
  help                       Show this help message

Environment variables (with defaults):
  PGANALYTICS_DATA     ${PGANALYTICS_DATA}
  PGANALYTICS_RUN      ${PGANALYTICS_RUN}
  PGANALYTICS_HOST     ${PGANALYTICS_HOST}
  PGANALYTICS_PORT     ${PGANALYTICS_PORT}
  PGANALYTICS_DB       ${PGANALYTICS_DB}
  PGANALYTICS_LOG      ${PGANALYTICS_LOG}
  PGANALYTICS_PRELOAD  ${PGANALYTICS_PRELOAD}
EOF
}

require_non_root() {
  if [ "$(id -u)" -eq 0 ]; then
    echo "Error: PostgreSQL refuses to run as root. Run pg-analytics as an unprivileged user." >&2
    exit 1
  fi
}

conninfo_quote() {
  local value="$1"
  value="${value//\\/\\\\}"
  value="${value//\'/\\\'}"
  printf "'%s'" "$value"
}

build_conninfo() {
  local dbname="$1"
  local peer_user
  peer_user=$(id -un)
  printf 'host=%s port=%s dbname=%s requirepeer=%s' \
    "$(conninfo_quote "$PGANALYTICS_RUN")" \
    "$(conninfo_quote "$PGANALYTICS_PORT")" \
    "$(conninfo_quote "$dbname")" \
    "$(conninfo_quote "$peer_user")"
}

verify_run_dir() {
  if [[ ! -d "$PGANALYTICS_RUN" || -L "$PGANALYTICS_RUN" || ! -O "$PGANALYTICS_RUN" || $(stat -c %a -- "$PGANALYTICS_RUN") != 700 ]]; then
    echo "Error: The socket directory must exist, be owned by you, and have mode 0700 (${PGANALYTICS_RUN})." >&2
    return 1
  fi
}

ensure_run_dir() {
  if [[ ! -e "$PGANALYTICS_RUN" ]]; then
    mkdir -p -m 700 -- "$PGANALYTICS_RUN"
  fi
  verify_run_dir
}

verify_target_cluster() {
  require_non_root
  if [ ! -f "${PGANALYTICS_DATA}/PG_VERSION" ]; then
    echo "Error: No cluster found at ${PGANALYTICS_DATA}. Run 'pg-analytics init' first." >&2
    return 1
  fi
  if ! pg_ctl -D "$PGANALYTICS_DATA" status >/dev/null 2>&1; then
    echo "Error: PostgreSQL cluster at ${PGANALYTICS_DATA} is not running. Run 'pg-analytics start' first." >&2
    return 1
  fi
  verify_run_dir

  local pid_file="${PGANALYTICS_DATA}/postmaster.pid"
  if [ ! -r "$pid_file" ]; then
    echo "Error: Cannot read ${pid_file}." >&2
    return 1
  fi

  local pid_port pid_sock expected_sock
  pid_port=$(sed -n '4p' "$pid_file")
  pid_sock=$(sed -n '5p' "$pid_file")
  if [ -z "$pid_port" ] || [ -z "$pid_sock" ]; then
    echo "Error: Cluster at ${PGANALYTICS_DATA} is not listening on a Unix socket yet." >&2
    return 1
  fi
  expected_sock=$(realpath -m -- "$PGANALYTICS_RUN")
  pid_sock=$(realpath -m -- "$pid_sock")

  if [ "$pid_port" != "$PGANALYTICS_PORT" ] || [ "$pid_sock" != "$expected_sock" ]; then
    echo "Error: Cluster at ${PGANALYTICS_DATA} is listening on ${pid_sock}:${pid_port}, not ${expected_sock}:${PGANALYTICS_PORT}." >&2
    return 1
  fi
}

cmd_init() {
  require_non_root

  if [ -f "${PGANALYTICS_DATA}/PG_VERSION" ]; then
    echo "Cluster already initialized at ${PGANALYTICS_DATA} (PostgreSQL $(cat "${PGANALYTICS_DATA}/PG_VERSION"))."
    return 0
  fi

  initdb \
    -D "$PGANALYTICS_DATA" \
    --auth-local=peer \
    --auth-host=scram-sha-256 \
    --encoding=UTF8 \
    --locale=C.UTF-8

  cat <<EOF
Initialized PostgreSQL ${PG_MAJOR} analytics cluster:
  Data dir:   ${PGANALYTICS_DATA}
  Socket dir: ${PGANALYTICS_RUN}

Next steps:
  pg-analytics start --foreground &   # Keep the Apptainer session open
  for _ in \$(seq 1 30); do pg-analytics status >/dev/null 2>&1 && break; sleep 1; done
  pg-analytics status
  pg-analytics enable-extensions
  pg-analytics psql
EOF
}

cmd_start() {
  require_non_root
  if [[ $# -gt 1 || ( $# -eq 1 && $1 != --foreground ) ]]; then
    echo "Usage: pg-analytics start [--foreground]" >&2
    return 2
  fi
  if [ ! -f "${PGANALYTICS_DATA}/PG_VERSION" ]; then
    echo "Error: No cluster found at ${PGANALYTICS_DATA}. Run 'pg-analytics init' first." >&2
    exit 1
  fi

  if pg_ctl -D "$PGANALYTICS_DATA" status >/dev/null 2>&1; then
    local pid_port pid_sock
    pid_port=$(sed -n '4p' "${PGANALYTICS_DATA}/postmaster.pid" 2>/dev/null || echo "$PGANALYTICS_PORT")
    pid_sock=$(sed -n '5p' "${PGANALYTICS_DATA}/postmaster.pid" 2>/dev/null || echo "$PGANALYTICS_RUN")
    echo "PostgreSQL analytics server is already running (socket: ${pid_sock}, port: ${pid_port})."
    return 0
  fi

  ensure_run_dir

  local -a options=(
    -h "$PGANALYTICS_HOST"
    -p "$PGANALYTICS_PORT"
    -k "$PGANALYTICS_RUN"
    -c "shared_preload_libraries=$PGANALYTICS_PRELOAD"
    -c timescaledb.telemetry_level=off
  )
  umask 077
  if [[ $# -eq 1 ]]; then
    echo "Starting PostgreSQL at ${PGANALYTICS_HOST}:${PGANALYTICS_PORT} (log: ${PGANALYTICS_LOG})."
    exec postgres -D "$PGANALYTICS_DATA" "${options[@]}" >>"$PGANALYTICS_LOG" 2>&1
  fi

  local postgres_options
  # pg_ctl passes -o through /bin/sh. Quote each argument for that shell.
  printf -v postgres_options "'%s' " "${options[@]//\'/\'\\\'\'}"
  if ! PGDATA="$PGANALYTICS_DATA" pg_ctl -o "$postgres_options" -w start >>"$PGANALYTICS_LOG" 2>&1; then
    echo "Error: PostgreSQL did not start. See ${PGANALYTICS_LOG}." >&2
    return 1
  fi

  echo "PostgreSQL analytics server listening on ${PGANALYTICS_HOST}:${PGANALYTICS_PORT} (socket: ${PGANALYTICS_RUN})."
}

cmd_stop() {
  require_non_root
  if [ ! -f "${PGANALYTICS_DATA}/PG_VERSION" ]; then
    echo "No cluster found at ${PGANALYTICS_DATA}."
    return 0
  fi

  if ! pg_ctl -D "$PGANALYTICS_DATA" status >/dev/null 2>&1; then
    echo "PostgreSQL analytics server is not running."
    return 0
  fi

  pg_ctl -D "$PGANALYTICS_DATA" -m fast -w stop
}

cmd_status() {
  echo "Data dir:   ${PGANALYTICS_DATA}"
  echo "Socket dir: ${PGANALYTICS_RUN}"
  echo "Endpoint:   ${PGANALYTICS_HOST}:${PGANALYTICS_PORT}"
  if [ ! -f "${PGANALYTICS_DATA}/PG_VERSION" ]; then
    echo "State:      uninitialized"
    return 3
  fi
  pg_ctl -D "$PGANALYTICS_DATA" status
  verify_target_cluster
  local conninfo
  conninfo=$(build_conninfo "$PGANALYTICS_DB")
  env -u PGHOST -u PGHOSTADDR -u PGPORT -u PGSERVICE -u PGSERVICEFILE -u PGREQUIREPEER \
    pg_isready -d "$conninfo"
}

cmd_psql() {
  verify_target_cluster
  local target_db="${PGDATABASE:-$PGANALYTICS_DB}"
  local -a forwarded=()
  local arg rest i ch prefix

  while [ "$#" -gt 0 ]; do
    arg="$1"
    shift
    case "$arg" in
      -h|--host|--host=*|-p|--port|--port=*)
        echo "Error: pg-analytics psql connects only to the verified cluster socket; use PGANALYTICS_RUN/PGANALYTICS_PORT or invoke psql directly for other endpoints." >&2
        return 2
        ;;
      -d|--dbname)
        if [ "$#" -eq 0 ]; then
          echo "Error: ${arg} requires a database name." >&2
          return 2
        fi
        target_db="$1"
        shift
        ;;
      --dbname=*)
        target_db="${arg#--dbname=}"
        ;;
      --command|--file|--field-separator|--log-file|--output|--pset|--record-separator|--set|--table-attr|--username|--variable)
        if [ "$#" -eq 0 ]; then
          echo "Error: ${arg} requires an argument." >&2
          return 2
        fi
        forwarded+=("$arg" "$1")
        shift
        ;;
      --command=*|--file=*|--field-separator=*|--log-file=*|--output=*|--pset=*|--record-separator=*|--set=*|--table-attr=*|--username=*|--variable=*)
        forwarded+=("$arg")
        ;;
      --list|--version|--no-psqlrc|--single-transaction|--help|--help=*|--echo-all|--echo-errors|--echo-queries|--echo-hidden|--no-readline|--quiet|--single-step|--single-line|--no-align|--csv|--html|--tuples-only|--expanded|--field-separator-zero|--record-separator-zero|--no-password|--password)
        forwarded+=("$arg")
        ;;
      --*)
        echo "Error: Unsupported or abbreviated psql option '${arg}'; use full non-endpoint options or invoke psql directly." >&2
        return 2
        ;;
      -?*)
        rest="${arg#-}"
        prefix="-"
        i=0
        while [ "$i" -lt "${#rest}" ]; do
          ch="${rest:$i:1}"
          case "$ch" in
            h|p)
              echo "Error: pg-analytics psql connects only to the verified cluster socket; use PGANALYTICS_RUN/PGANALYTICS_PORT or invoke psql directly for other endpoints." >&2
              return 2
              ;;
            d)
              if [ "$prefix" != "-" ]; then
                forwarded+=("$prefix")
                prefix="-"
              fi
              if [ $((i + 1)) -lt "${#rest}" ]; then
                target_db="${rest:$((i + 1))}"
              else
                if [ "$#" -eq 0 ]; then
                  echo "Error: -d requires a database name." >&2
                  return 2
                fi
                target_db="$1"
                shift
              fi
              break
              ;;
            c|f|F|L|o|P|R|T|U|v)
              prefix="${prefix}${rest:$i}"
              forwarded+=("$prefix")
              prefix="-"
              if [ $((i + 1)) -eq "${#rest}" ]; then
                if [ "$#" -eq 0 ]; then
                  echo "Error: -${ch} requires an argument." >&2
                  return 2
                fi
                forwarded+=("$1")
                shift
              fi
              break
              ;;
            *)
              prefix="${prefix}${ch}"
              ;;
          esac
          i=$((i + 1))
        done
        if [ "$prefix" != "-" ]; then
          forwarded+=("$prefix")
        fi
        ;;
      *)
        echo "Error: Positional connection arguments are not supported; use -d <dbname> to select a database." >&2
        return 2
        ;;
    esac
  done

  local conninfo
  conninfo=$(build_conninfo "$target_db")
  exec env -u PGHOST -u PGHOSTADDR -u PGPORT -u PGSERVICE -u PGSERVICEFILE -u PGREQUIREPEER -u PGDATABASE \
    psql -d "$conninfo" "${forwarded[@]}"
}

cmd_enable_extensions() {
  verify_target_cluster
  local target_db="${1:-$PGANALYTICS_DB}"
  local expected_data conninfo
  expected_data=$(sed -n '2p' "${PGANALYTICS_DATA}/postmaster.pid")
  if [ -z "$expected_data" ] || [ "$(realpath -- "$expected_data")" != "$(realpath -- "$PGANALYTICS_DATA")" ]; then
    echo "Error: Cluster postmaster.pid data directory (${expected_data}) does not match PGANALYTICS_DATA (${PGANALYTICS_DATA})." >&2
    return 1
  fi
  conninfo=$(build_conninfo "$target_db")

  env -u PGHOST -u PGHOSTADDR -u PGPORT -u PGSERVICE -u PGSERVICEFILE -u PGREQUIREPEER -u PGDATABASE \
    psql -X -d "$conninfo" -v ON_ERROR_STOP=1 -v expected_data="$expected_data" <<'SQL'
SELECT set_config('pg_analytics.expected_data', :'expected_data', false) \g /dev/null
DO $$
DECLARE
  actual_data text := current_setting('data_directory');
  expected_data text := current_setting('pg_analytics.expected_data');
BEGIN
  IF actual_data <> expected_data THEN
    RAISE EXCEPTION 'Connected server data directory (%) does not match PGANALYTICS_DATA (%)', actual_data, expected_data;
  END IF;
END
$$;

CREATE EXTENSION IF NOT EXISTS postgis;
CREATE EXTENSION IF NOT EXISTS postgis_topology;
CREATE EXTENSION IF NOT EXISTS postgis_raster;
CREATE EXTENSION IF NOT EXISTS vector;
CREATE EXTENSION IF NOT EXISTS pgedge_vectorizer;
CREATE EXTENSION IF NOT EXISTS plproxy;
CREATE EXTENSION IF NOT EXISTS timescaledb;
CREATE EXTENSION IF NOT EXISTS hll;
CREATE EXTENSION IF NOT EXISTS tdigest;
CREATE EXTENSION IF NOT EXISTS hypopg;
CREATE EXTENSION IF NOT EXISTS pg_stat_statements;
CREATE EXTENSION IF NOT EXISTS btree_gin;
CREATE EXTENSION IF NOT EXISTS btree_gist;
CREATE EXTENSION IF NOT EXISTS pg_trgm;
CREATE EXTENSION IF NOT EXISTS hstore;
CREATE EXTENSION IF NOT EXISTS "uuid-ossp";
CREATE EXTENSION IF NOT EXISTS citext;
CREATE EXTENSION IF NOT EXISTS cube;
CREATE EXTENSION IF NOT EXISTS earthdistance;
CREATE EXTENSION IF NOT EXISTS tablefunc;

SELECT extname, extversion FROM pg_extension ORDER BY extname;
SQL
}

main() {
  local cmd="${1:-help}"
  if [ "$#" -gt 0 ]; then
    shift
  fi

  case "$cmd" in
    init) cmd_init "$@" ;;
    start) cmd_start "$@" ;;
    stop) cmd_stop "$@" ;;
    status) cmd_status "$@" ;;
    psql) cmd_psql "$@" ;;
    enable-extensions) cmd_enable_extensions "$@" ;;
    help|-h|--help) usage ;;
    *)
      echo "Unknown command: ${cmd}" >&2
      usage >&2
      exit 1
      ;;
  esac
}

main "$@"
