{
  "general": {
    "name": { "en": "topofit" },
    "version": "VERSION_WILL_BE_REPLACED_BY_SCRIPT",
    "vendor": "neurodesk",
    "information": { "en": "Fast research-only cortical surface reconstruction with BrainNet TopoFit." },
    "id": "topofit",
    "regulatory_information": {
      "device_trade_name": "topofit",
      "production_identifier": "VERSION_WILL_BE_REPLACED_BY_SCRIPT",
      "manufacturer_address": "Erlangen, Germany",
      "made_in": "DE",
      "manufacture_date": "2026/09/02",
      "material_number": "topofit_VERSION_WILL_BE_REPLACED_BY_SCRIPT",
      "gtin": "00860000171212",
      "udi": "(01)00860000171212(21)VERSION_WILL_BE_REPLACED_BY_SCRIPT",
      "safety_advices": "Research use only. The output is not motion-cleared and must not be used directly for slice prescription.",
      "special_operating_instructions": "OpenRecon TopoFit cortical surface workflow",
      "additional_relevant_information": "The scanner receives a source-grid QC overlay. Surface files remain in the run workspace for downstream research analysis."
    }
  },
  "reconstruction": {
    "transfer_protocol": {
      "protocol": "ISMRMRD",
      "version": "1.4.1"
    },
    "port": 9002,
    "emitter": "image",
    "injector": "image",
    "can_process_adjustment_data": false,
    "can_use_gpu": true,
    "min_count_required_gpus": 1,
    "min_required_gpu_memory": 10048,
    "min_required_memory": 20048,
    "min_count_required_cpu_cores": 8,
    "content_qualification_type": "RESEARCH"
  },
  "parameters": [
    {
      "id": "config",
      "label": { "en": "config" },
      "type": "choice",
      "values": [
        {
          "id": "topofit",
          "name": { "en": "topofit" }
        }
      ],
      "default": "topofit",
      "information": { "en": "Select the TopoFit MRD server configuration." }
    },
    {
      "id": "sendoriginal",
      "label": { "en": "Keep original images" },
      "type": "boolean",
      "default": true,
      "information": { "en": "Return a restamped copy of the selected anatomical input before the TopoFit QC series." }
    },
    {
      "id": "tfdevice",
      "label": { "en": "Inference device" },
      "type": "choice",
      "values": [
        {
          "id": "cuda",
          "name": { "en": "GPU (CUDA)" }
        },
        {
          "id": "cpu",
          "name": { "en": "CPU" }
        }
      ],
      "default": "cuda",
      "information": { "en": "Use the reconstruction GPU for the fastest inference. CPU is intended for compatibility testing." }
    },
    {
      "id": "tfmodel",
      "label": { "en": "TopoFit model" },
      "type": "choice",
      "values": [
        {
          "id": "t1w_1mm",
          "name": { "en": "T1w 1 mm" }
        },
        {
          "id": "synth_random",
          "name": { "en": "Synthetic random resolution" }
        },
        {
          "id": "synth_1mm",
          "name": { "en": "Synthetic 1 mm" }
        }
      ],
      "default": "t1w_1mm",
      "information": { "en": "Choose the pretrained BrainNet model. T1w 1 mm is the default for an MPRAGE." }
    },
    {
      "id": "tfconform",
      "label": { "en": "Conform input" },
      "type": "boolean",
      "default": true,
      "information": { "en": "Resample the input internally to the 1 mm RAS geometry expected by TopoFit while writing QC back on the source grid." }
    },
    {
      "id": "tfflatpatches",
      "label": { "en": "Find cortical patches" },
      "type": "boolean",
      "default": false,
      "information": { "en": "Find ranked, non-overlapping cortical patches with visible IDs and outward unit normals. Return a DICOM table with patient LPH centers in mm and Siemens signed plane angles in degrees for all six Sag/Cor/Tra orders. Default: up to three per hemisphere at 50% depth. Automatic candidates are not lesion ROIs or matched controls." }
    },
    {
      "id": "tfpatchcount", "label": { "en": "Maximum patches per hemisphere" },
      "type": "int", "minimum": 1, "maximum": 100, "default": 3,
      "information": { "en": "Return up to 100 distinct patches per selected hemisphere. LH01, LH02, ... and RH01, RH02, ... are numbered independently by increasing score: RMS plane-fit error + radius * (1 - normal coherence). Lower scores indicate flatter patches with more consistent normals. Overlapping candidates are skipped. Fewer patches may meet the quality criteria." }
    },
    {
      "id": "tfpatchradius", "label": { "en": "Cortical patch radius" },
      "type": "double", "minimum": 2.0, "maximum": 20.0, "default": 10.0,
      "unit": { "en": "mm" },
      "information": { "en": "Radius of 2-20 mm along cortical mesh edges, not straight-line distance through the brain. This is a radius, not a diameter." }
    },
    {
      "id": "tfpatchhemisphere", "label": { "en": "Patch hemisphere" },
      "type": "choice", "default": "both",
      "values": [
        { "id": "both", "name": { "en": "Both" } },
        { "id": "lh", "name": { "en": "Left" } },
        { "id": "rh", "name": { "en": "Right" } }
      ],
      "information": { "en": "Restrict cortical patch search to the selected hemisphere. Surface reconstruction remains bilateral." }
    },
    {
      "id": "tfpatchregion", "label": { "en": "Patch search region" },
      "type": "choice", "default": "cortex",
      "values": [
        { "id": "cortex", "name": { "en": "Whole eligible cortex" } },
        { "id": "roi", "name": { "en": "Native-space ROI" } },
        { "id": "wang2015:visual", "name": { "en": "Wang 2015: Visual cortex (all mapped areas)" } },
        { "id": "wang2015:V1", "name": { "en": "Wang 2015: V1" } },
        { "id": "wang2015:V2", "name": { "en": "Wang 2015: V2" } },
        { "id": "wang2015:V3", "name": { "en": "Wang 2015: V3" } },
        { "id": "wang2015:hV4", "name": { "en": "Wang 2015: hV4" } },
        { "id": "wang2015:VO1", "name": { "en": "Wang 2015: VO1" } },
        { "id": "wang2015:VO2", "name": { "en": "Wang 2015: VO2" } },
        { "id": "wang2015:PHC1", "name": { "en": "Wang 2015: PHC1" } },
        { "id": "wang2015:PHC2", "name": { "en": "Wang 2015: PHC2" } },
        { "id": "wang2015:TO1", "name": { "en": "Wang 2015: TO1" } },
        { "id": "wang2015:TO2", "name": { "en": "Wang 2015: TO2" } },
        { "id": "wang2015:LO1", "name": { "en": "Wang 2015: LO1" } },
        { "id": "wang2015:LO2", "name": { "en": "Wang 2015: LO2" } },
        { "id": "wang2015:V3A", "name": { "en": "Wang 2015: V3A" } },
        { "id": "wang2015:V3B", "name": { "en": "Wang 2015: V3B" } },
        { "id": "wang2015:IPS0", "name": { "en": "Wang 2015: IPS0" } },
        { "id": "wang2015:IPS1", "name": { "en": "Wang 2015: IPS1" } },
        { "id": "wang2015:IPS2", "name": { "en": "Wang 2015: IPS2" } },
        { "id": "wang2015:IPS3", "name": { "en": "Wang 2015: IPS3" } },
        { "id": "wang2015:IPS4", "name": { "en": "Wang 2015: IPS4" } },
        { "id": "wang2015:IPS5", "name": { "en": "Wang 2015: IPS5" } },
        { "id": "wang2015:SPL1", "name": { "en": "Wang 2015: SPL1" } },
        { "id": "wang2015:FEF", "name": { "en": "Wang 2015: FEF" } },
        { "id": "wang2015:V1v", "name": { "en": "Wang 2015: V1 ventral (V1v)" } },
        { "id": "wang2015:V1d", "name": { "en": "Wang 2015: V1 dorsal (V1d)" } },
        { "id": "wang2015:V2v", "name": { "en": "Wang 2015: V2 ventral (V2v)" } },
        { "id": "wang2015:V2d", "name": { "en": "Wang 2015: V2 dorsal (V2d)" } },
        { "id": "wang2015:V3v", "name": { "en": "Wang 2015: V3 ventral (V3v)" } },
        { "id": "wang2015:V3d", "name": { "en": "Wang 2015: V3 dorsal (V3d)" } },
        { "id": "aparc:lobe-frontal", "name": { "en": "Lobe: Frontal lobe" } },
        { "id": "aparc:lobe-parietal", "name": { "en": "Lobe: Parietal lobe" } },
        { "id": "aparc:lobe-temporal", "name": { "en": "Lobe: Temporal lobe" } },
        { "id": "aparc:lobe-occipital", "name": { "en": "Lobe: Occipital lobe" } },
        { "id": "aparc:lobe-cingulate", "name": { "en": "Lobe: Cingulate cortex" } },
        { "id": "aparc:lobe-insula", "name": { "en": "Lobe: Insula" } },
        { "id": "aparc:bankssts", "name": { "en": "Desikan-Killiany: Banks of the superior temporal sulcus" } },
        { "id": "aparc:caudalanteriorcingulate", "name": { "en": "Desikan-Killiany: Caudal anterior cingulate" } },
        { "id": "aparc:caudalmiddlefrontal", "name": { "en": "Desikan-Killiany: Caudal middle frontal" } },
        { "id": "aparc:cuneus", "name": { "en": "Desikan-Killiany: Cuneus" } },
        { "id": "aparc:entorhinal", "name": { "en": "Desikan-Killiany: Entorhinal" } },
        { "id": "aparc:frontalpole", "name": { "en": "Desikan-Killiany: Frontal pole" } },
        { "id": "aparc:fusiform", "name": { "en": "Desikan-Killiany: Fusiform" } },
        { "id": "aparc:inferiorparietal", "name": { "en": "Desikan-Killiany: Inferior parietal" } },
        { "id": "aparc:inferiortemporal", "name": { "en": "Desikan-Killiany: Inferior temporal" } },
        { "id": "aparc:insula", "name": { "en": "Desikan-Killiany: Insula" } },
        { "id": "aparc:isthmuscingulate", "name": { "en": "Desikan-Killiany: Isthmus cingulate" } },
        { "id": "aparc:lateraloccipital", "name": { "en": "Desikan-Killiany: Lateral occipital" } },
        { "id": "aparc:lateralorbitofrontal", "name": { "en": "Desikan-Killiany: Lateral orbitofrontal" } },
        { "id": "aparc:lingual", "name": { "en": "Desikan-Killiany: Lingual" } },
        { "id": "aparc:medialorbitofrontal", "name": { "en": "Desikan-Killiany: Medial orbitofrontal" } },
        { "id": "aparc:middletemporal", "name": { "en": "Desikan-Killiany: Middle temporal" } },
        { "id": "aparc:paracentral", "name": { "en": "Desikan-Killiany: Paracentral" } },
        { "id": "aparc:parahippocampal", "name": { "en": "Desikan-Killiany: Parahippocampal" } },
        { "id": "aparc:parsopercularis", "name": { "en": "Desikan-Killiany: Pars opercularis" } },
        { "id": "aparc:parsorbitalis", "name": { "en": "Desikan-Killiany: Pars orbitalis" } },
        { "id": "aparc:parstriangularis", "name": { "en": "Desikan-Killiany: Pars triangularis" } },
        { "id": "aparc:pericalcarine", "name": { "en": "Desikan-Killiany: Pericalcarine" } },
        { "id": "aparc:postcentral", "name": { "en": "Desikan-Killiany: Postcentral" } },
        { "id": "aparc:posteriorcingulate", "name": { "en": "Desikan-Killiany: Posterior cingulate" } },
        { "id": "aparc:precentral", "name": { "en": "Desikan-Killiany: Precentral" } },
        { "id": "aparc:precuneus", "name": { "en": "Desikan-Killiany: Precuneus" } },
        { "id": "aparc:rostralanteriorcingulate", "name": { "en": "Desikan-Killiany: Rostral anterior cingulate" } },
        { "id": "aparc:rostralmiddlefrontal", "name": { "en": "Desikan-Killiany: Rostral middle frontal" } },
        { "id": "aparc:superiorfrontal", "name": { "en": "Desikan-Killiany: Superior frontal" } },
        { "id": "aparc:superiorparietal", "name": { "en": "Desikan-Killiany: Superior parietal" } },
        { "id": "aparc:superiortemporal", "name": { "en": "Desikan-Killiany: Superior temporal" } },
        { "id": "aparc:supramarginal", "name": { "en": "Desikan-Killiany: Supramarginal" } },
        { "id": "aparc:temporalpole", "name": { "en": "Desikan-Killiany: Temporal pole" } },
        { "id": "aparc:transversetemporal", "name": { "en": "Desikan-Killiany: Transverse temporal" } }
      ],
      "information": { "en": "Whole cortex, a native-space ROI, or a named atlas region: Wang 2015 visual areas (V1, V2, V3 and higher areas, or their ventral/dorsal halves), Desikan-Killiany lobes, or Desikan-Killiany regions. Named regions are fsaverage atlas estimates mapped through the TopoFit registration sphere, not an individual's retinotopy or parcellation, and require cortical patch search. ROI mode requires a supplied NIfTI mask on the source image grid and never falls back to whole-brain search." }
    },
    {
      "id": "tfpatchroi", "label": { "en": "Native-space ROI path" },
      "type": "string", "default": "",
      "information": { "en": "Container-visible path to a NIfTI mask, for example /data/roi.nii.gz. Used only in ROI mode. The mask must already be registered to the input image." }
    },
    {
      "id": "tfsulcalmiddepth",
      "label": { "en": "Find sulcal mid-depth voxels" },
      "type": "boolean",
      "default": false,
      "information": { "en": "Classify concave pial regions by signed mean curvature and write the source-grid voxels intersected at 50% cortical depth." }
    },
    {
      "id": "tfsulcalthreshold",
      "label": { "en": "Sulcal curvature threshold" },
      "type": "double",
      "minimum": 0.1,
      "maximum": 1.0,
      "default": 0.1,
      "information": { "en": "Set the minimum magnitude of negative, concave mean curvature used to classify sulcal vertices." }
    },
    {
      "id": "tfoverlaythickness",
      "label": { "en": "Surface thickness" },
      "type": "int",
      "minimum": 0,
      "maximum": 3,
      "default": 1,
      "unit": { "en": "vox" },
      "information": { "en": "Set the in-plane dilation radius in voxels. Zero draws the undilated projected vertices; one retains the previous width." }
    }
  ]
}
