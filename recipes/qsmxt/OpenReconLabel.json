  "parameters": [
    {
      "id": "config",
      "label": { "en": "Config" },
      "type": "choice",
      "values": [
        {
          "id": "qsmxt",
          "name": { "en": "standard GRE" }
        },
        {
          "id": "qsmxt_gre_motion",
          "name": { "en": "standard GRE + echo motion alignment" }
        },
        {
          "id": "qsmxt_ep3d",
          "name": { "en": "3D EPI dual polarity QSM" }
        },
        {
          "id": "qsmxt_ep3d_denoise",
          "name": { "en": "3D EPI dual polarity QSM + NLM denoise" }
        }
      ],
      "default": "qsmxt",
      "information": { "en": "Standard GRE reconstructs magnitude and phase. The echo motion alignment variant always aligns GRE echoes to the first echo unless an advanced motionreference is supplied. EPI modes motion correct, phase match, and complex average dual-polarity repetitions, with optional NLM denoising." }
    },
    {
      "id": "inputseries",
      "label": { "en": "Input images" },
      "type": "choice",
      "values": [
        { "id": "distortion-corrected", "name": { "en": "Distortion corrected" } },
        { "id": "non-distortion-corrected", "name": { "en": "Not distortion corrected (ND)" } },
        { "id": "both", "name": { "en": "Both" } }
      ],
      "default": "distortion-corrected",
      "information": { "en": "Choose the magnitude and phase images used by QSMxT. ND matches source series containing a separate ND name token. Both runs QSMxT twice and returns separately named DC and ND results." }
    },
    {
      "id": "sendoutputs",
      "label": { "en": "Output maps" },
      "type": "choice",
      "values": [
        { "id": "qsm", "name": { "en": "QSM" } },
        { "id": "all", "name": { "en": "All available" } },
        { "id": "magnitude", "name": { "en": "Magnitude" } },
        { "id": "mask", "name": { "en": "Mask" } },
        { "id": "swi", "name": { "en": "SWI" } },
        { "id": "smwi", "name": { "en": "SMWI" } },
        { "id": "t2star", "name": { "en": "T2 star" } },
        { "id": "r2star", "name": { "en": "R2 star" } }
      ],
      "default": "qsm",
      "information": { "en": "Select which QSMxT derivatives to send back to OpenRecon. All available omits T2*/R2* below three selected echoes. Selecting T2*/R2* explicitly requires at least three echoes. EPI repetitions produce one echo. SMWI returns paramagnetic and diamagnetic images weighted by the QSM map. Source separation adds its maps when enabled. Original magnitude and phase images are always returned." }
    },
    {
      "id": "inhomogeneitycorrection",
      "label": { "en": "Homogeneity correction" },
      "type": "choice",
      "values": [
        { "id": "off", "name": { "en": "Off" } },
        { "id": "standard", "name": { "en": "Standard" } },
        { "id": "fine", "name": { "en": "Fine" } }
      ],
      "default": "standard",
      "information": { "en": "Correct magnitude for masks and SMWI. Standard uses 7 mm smoothing and 3 tissue-estimation boxes per axis. Fine uses 7 mm smoothing and 15 tissue-estimation boxes per axis. Off disables this correction. CLEAR-SWI applies its own receive-sensitivity correction independently." }
    },
    {
      "id": "maskpreset",
