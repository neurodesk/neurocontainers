{
  "general": {
    "name": { "en": "qsmxt" },
    "version": "VERSION_WILL_BE_REPLACED_BY_SCRIPT",
    "vendor": "neurodesk",
    "information": { "en": "QSMxT quantitative susceptibility mapping from reconstructed magnitude and phase images." },
    "id": "qsmxt",
    "regulatory_information": {
      "device_trade_name": "qsmxt",
      "production_identifier": "VERSION_WILL_BE_REPLACED_BY_SCRIPT",
      "manufacturer_address": "Erlangen, Germany",
      "made_in": "DE",
      "manufacture_date": "2026/06/26",
      "material_number": "qsmxt_VERSION_WILL_BE_REPLACED_BY_SCRIPT",
      "gtin": "00860000171212",
      "udi": "(01)00860000171212(21)VERSION_WILL_BE_REPLACED_BY_SCRIPT",
      "safety_advices": "",
      "special_operating_instructions": "OpenRecon QSMxT reconstruction",
      "additional_relevant_information": ""
    }
  },
  "reconstruction": {
    "transfer_protocol": {
      "protocol": "ISMRMRD",
      "version": "1.4.1"
    },
    "port": 9002,
    "emitter": "image",
    "injector": "image",
    "can_process_adjustment_data": false,
    "can_use_gpu": false,
    "min_count_required_gpus": 0,
    "min_required_gpu_memory": 0,
    "min_required_memory": 32000,
    "min_count_required_cpu_cores": 24,
    "content_qualification_type": "RESEARCH"
  },
  "parameters": [
    {
      "id": "config",
      "label": { "en": "config" },
      "type": "choice",
      "values": [
        {
          "id": "qsmxt",
          "name": { "en": "standard GRE" }
        },
        {
          "id": "qsmxt_ep3d",
          "name": { "en": "3D EPI dual polarity QSM" }
        },
        {
          "id": "qsmxt_ep3d_denoise",
          "name": { "en": "3D EPI dual polarity QSM + NLM denoise" }
        }
      ],
      "default": "qsmxt",
      "information": { "en": "qsmxt reconstructs GRE magnitude and phase. 3D EPI dual polarity QSM first motion corrects (FSL MCFLIRT), phase matches and complex averages the repetitions of a single-TE 3D EPI series with alternating readout polarity, using ep3d-highres-preprocessing. The NLM denoise variant also denoises the average (ANTs), which takes longer." }
    },
    {
      "id": "inputseries",
      "label": { "en": "Input images" },
      "type": "choice",
      "values": [
        { "id": "distortion-corrected", "name": { "en": "Distortion corrected" } },
        { "id": "non-distortion-corrected", "name": { "en": "Not distortion corrected (ND)" } },
        { "id": "both", "name": { "en": "Both" } }
      ],
      "default": "distortion-corrected",
      "information": { "en": "Choose the magnitude and phase images used by QSMxT. ND matches source series containing a separate ND name token. Both runs QSMxT twice and returns separately named DC and ND results." }
    },
    {
      "id": "sendoutputs",
      "label": { "en": "Output maps" },
      "type": "choice",
      "values": [
        { "id": "qsm", "name": { "en": "QSM" } },
        { "id": "all", "name": { "en": "All available" } },
        { "id": "magnitude", "name": { "en": "Magnitude" } },
        { "id": "mask", "name": { "en": "Mask" } },
        { "id": "swi", "name": { "en": "SWI" } },
        { "id": "smwi", "name": { "en": "SMWI" } },
        { "id": "t2star", "name": { "en": "T2 star" } },
        { "id": "r2star", "name": { "en": "R2 star" } }
      ],
      "default": "qsm",
      "information": { "en": "Select which QSMxT derivatives to send back to OpenRecon. SMWI returns paramagnetic and diamagnetic images weighted by the QSM map. Source separation adds its maps when enabled. Original magnitude and phase images are always returned." }
    },
    {
      "id": "sourceseparation",
      "label": { "en": "Source separation" },
      "type": "choice",
      "values": [
        { "id": "off", "name": { "en": "Off" } },
        { "id": "r2star-qsm", "name": { "en": "R2*-QSM" } },
        { "id": "decompose", "name": { "en": "DECOMPOSE" } }
      ],
      "default": "off",
      "information": { "en": "Add paramagnetic, diamagnetic, and separated-total susceptibility maps. Requires at least three GRE magnitude and unfiltered phase echoes. R2*-QSM needs equally spaced echoes. No spin-echo acquisition is needed." }
    },
    {
      "id": "qsmalgorithm",
