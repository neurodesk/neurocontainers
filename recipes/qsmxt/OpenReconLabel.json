        { "id": "lsqr", "name": { "en": "LSQR" } },
        { "id": "heidi", "name": { "en": "HEIDI" } },
        { "id": "qsmart", "name": { "en": "QSMART" } },
        { "id": "tfi", "name": { "en": "TFI" } },
        { "id": "ndi", "name": { "en": "NDI" } },
        { "id": "fansi", "name": { "en": "FANSI" } },
        { "id": "fansi-tgv", "name": { "en": "FANSI-TGV" } },
        { "id": "l1qsm", "name": { "en": "L1-QSM" } },
        { "id": "amp-pe", "name": { "en": "AMP-PE" } },
        { "id": "xqsm", "name": { "en": "xQSM" } },
        { "id": "qsmnet", "name": { "en": "QSMnet" } },
        { "id": "qsmnet-plus", "name": { "en": "QSMnet+" } },
        { "id": "autoqsm", "name": { "en": "AutoQSM" } },
        { "id": "qsmgan", "name": { "en": "QSMGAN" } },
        { "id": "ir2qsm", "name": { "en": "IR2QSM" } },
        { "id": "lpcnn", "name": { "en": "LPCNN" } },
        { "id": "modl-qsm", "name": { "en": "MoDL-QSM" } },
        { "id": "nextqsm", "name": { "en": "NeXtQSM" } },
        { "id": "iqsm", "name": { "en": "iQSM" } },
        { "id": "iqsm-plus", "name": { "en": "iQSM+" } }
      ],
      "default": "rts",
      "information": { "en": "Select the reconstruction algorithm. Advanced pipelinepreset configuration can override this choice." }
    },
    {
      "id": "unwrappingalgorithm",
      "label": { "en": "Unwrap" },
      "type": "choice",
      "values": [
        { "id": "default", "name": { "en": "Default (ROMEO)" } },
        { "id": "romeo", "name": { "en": "ROMEO" } },
        { "id": "laplacian", "name": { "en": "Laplacian" } }
      ],
      "default": "romeo",
      "information": { "en": "Select the reconstruction algorithm. Advanced pipelinepreset configuration can override this choice." }
    },
    {
      "id": "bfalgorithm",
      "label": { "en": "Background" },
      "type": "choice",
      "values": [
        { "id": "default", "name": { "en": "Default (V-SHARP)" } },
        { "id": "vsharp", "name": { "en": "V-SHARP" } },
        { "id": "pdf", "name": { "en": "PDF" } },
        { "id": "lbv", "name": { "en": "LBV" } },
        { "id": "ismv", "name": { "en": "iSMV" } },
        { "id": "sharp", "name": { "en": "SHARP" } },
        { "id": "resharp", "name": { "en": "RESHARP" } },
        { "id": "harperella", "name": { "en": "HARPERELLA" } },
        { "id": "iharperella", "name": { "en": "iHARPERELLA" } },
        { "id": "bfrnet", "name": { "en": "BFRnet" } },
        { "id": "iqfm", "name": { "en": "iQFM" } }
      ],
      "default": "vsharp",
      "information": { "en": "Select the reconstruction algorithm. Advanced pipelinepreset configuration can override this choice." }
    },
    {
      "id": "maskpreset",
      "label": { "en": "Mask preset" },
      "type": "choice",
      "values": [
        { "id": "bet", "name": { "en": "BET" } },
        { "id": "robust-threshold", "name": { "en": "Robust threshold" } },
        { "id": "combined", "name": { "en": "BET + threshold union" } },
        { "id": "hd-bet", "name": { "en": "HD-BET" } }
      ],
      "default": "robust-threshold",
      "information": { "en": "Robust threshold uses Otsu on combined magnitude, with closing and hole filling. Combined unions BET and threshold masks. HD-BET uses the packaged brain extraction model." }
    },
    {
      "id": "inhomogeneitycorrection",
      "label": { "en": "Homogeneity correction" },
      "type": "choice",
      "values": [
        { "id": "off", "name": { "en": "Off" } },
        { "id": "standard", "name": { "en": "Standard" } },
        { "id": "fine", "name": { "en": "Fine" } }
      ],
      "default": "standard",
      "information": { "en": "Correct magnitude intensity inhomogeneity. Standard uses 7 mm smoothing and 3 local segmentation boxes per dimension. Fine uses 7 mm smoothing and 15 boxes per dimension for comparison. The corrected magnitude is used for SWI and SMWI. Off disables correction." }
    },
    {
      "id": "twopass",
      "label": {"en": "Two-pass QSM"},
      "type": "boolean",
      "default": false,
      "information": {"en": "Reconstruct on a reliable phase-quality mask and use the ordinary pass to fill unreliable regions."}
    },
    {
      "id": "motioncorrection",
      "label": {"en": "Multiecho motion correction"},
      "type": "boolean",
      "default": false,
      "information": {"en": "Rigidly align GRE echoes using magnitude and apply transforms to the complex signal. Separate from dual polarity repetition preprocessing."}
    },
    {
      "id": "qsmreference",
      "label": {"en": "QSM reference"},
      "type": "string",
      "default": "mean",
      "information": {"en": "Mean, none, any SynthSeg v1 region name or label id, or comma-separated union. Examples include ventricles, left-thalamus, and 4,43. Region references run packaged SynthSeg on magnitude anatomy."}
    },
    {
      "id": "vsharpgrid",
      "label": {"en": "V-SHARP grid"},
      "type": "choice",
      "default": "native",
      "information": {"en": "Choose the grid for background field removal. Native preserves acquired anisotropic resolution. Isotropic spacing can be set in advanced configuration."},
      "values": [
        {"id": "native", "name": {"en": "Native"}},
        {"id": "finest", "name": {"en": "Finest voxel"}},
        {"id": "isotropic", "name": {"en": "Isotropic"}}
      ]
    },
    {
      "id": "swiunwrapping",
      "label": {"en": "SWI unwrapping"},
      "type": "choice",
      "default": "laplacian",
      "information": {"en": "Choose SWI phase unwrapping independently of QSM. Slice Laplacian supports contiguous 2D stacks."},
      "values": [
        {"id": "laplacian", "name": {"en": "Laplacian"}},
        {"id": "laplacian-slice", "name": {"en": "Slice Laplacian"}},
        {"id": "romeo", "name": {"en": "ROMEO"}}
      ]
    }
