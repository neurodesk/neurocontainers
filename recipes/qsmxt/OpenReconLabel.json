        { "id": "hdqsm", "name": { "en": "HD-QSM" } },
        { "id": "rts", "name": { "en": "RTS" } },
        { "id": "tv", "name": { "en": "TV" } },
        { "id": "tkd", "name": { "en": "TKD" } },
        { "id": "tsvd", "name": { "en": "TSVD" } },
        { "id": "tgv", "name": { "en": "TGV" } },
