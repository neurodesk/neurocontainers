      ],
      "default": "qsm",
      "information": { "en": "Select which QSMxT derivatives to send back to OpenRecon. SMWI returns paramagnetic and diamagnetic images weighted by the QSM map. Source separation adds its maps when enabled. Original magnitude and phase images are always returned." }
