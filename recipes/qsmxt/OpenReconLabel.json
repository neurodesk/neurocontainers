        { "id": "combined", "name": { "en": "BET + threshold union" } },
        { "id": "hd-bet", "name": { "en": "HD-BET" } }
      ],
      "default": "robust-threshold",
      "information": { "en": "Robust threshold uses Otsu on combined magnitude, with closing and hole filling. Combined unions BET and threshold masks. HD-BET uses the packaged brain extraction model." }
