+#[cfg(feature = "parallel")]
+fn z_rows(data: &mut [f64], nx: usize, ny: usize, nz: usize) -> Vec<Vec<&mut [f64]>> {
+    let mut groups: Vec<Vec<&mut [f64]>> = (0..ny).map(|_| Vec::with_capacity(nz)).collect();
+    // Each mutable x row belongs to exactly one y group. No voxel buffer is copied.
+    for (index, row) in data.chunks_mut(nx).enumerate() {
+        groups[index % ny].push(row);
+    }
+    groups
+}
+
+#[cfg(feature = "parallel")]
+fn gaussian_smooth_pass_parallel(
+    data: &mut [f64], mut weight: Option<&mut [f64]>, sizes: [usize; 3],
+    masked: bool, reverse: bool, grid: &Grid,
+) {
+    let (nx, ny, nz) = grid.dims;
+    if data.is_empty() { return; }
+    // Masked smoothing ignores weights, just as in the serial implementation.
+    if masked { weight = None; }
+    if nx > 1 && sizes[0] >= 3 {
+        if let Some(w) = weight.as_deref_mut() {
+            data.par_chunks_mut(nx).zip(w.par_chunks_mut(nx)).for_each(|(line, w)| {
+                filter_line_parallel(line, Some(w), sizes[0], masked, reverse);
+            });
+        } else {
+            data.par_chunks_mut(nx).for_each(|line| {
+                filter_line_parallel(line, None, sizes[0], masked, reverse);
+            });
+        }
+    }
+    if ny > 1 && sizes[1] >= 3 {
+        if let Some(w) = weight.as_deref_mut() {
+            data.par_chunks_mut(nx * ny).zip(w.par_chunks_mut(nx * ny)).for_each(|(plane, w)| {
+                filter_columns_parallel(plane.chunks_mut(nx).collect(), Some(w.chunks_mut(nx).collect()), sizes[1], masked, reverse);
+            });
+        } else {
+            data.par_chunks_mut(nx * ny).for_each(|plane| {
+                filter_columns_parallel(plane.chunks_mut(nx).collect(), None, sizes[1], masked, reverse);
+            });
+        }
+    }
+    if nz > 1 && sizes[2] >= 3 {
+        let rows = z_rows(data, nx, ny, nz);
+        if let Some(w) = weight {
+            rows.into_par_iter().zip(z_rows(w, nx, ny, nz)).for_each(|(rows, w)| {
+                filter_columns_parallel(rows, Some(w), sizes[2], masked, reverse);
+            });
+        } else {
+            rows.into_par_iter().for_each(|rows| {
+                filter_columns_parallel(rows, None, sizes[2], masked, reverse);
+            });
+        }
+    }
+}
