+#[cfg(feature = "parallel")]
+fn filter_columns_parallel(
+    mut rows: Vec<&mut [f64]>, mut weights: Option<Vec<&mut [f64]>>,
+    size: usize, masked: bool, reverse: bool,
+) {
+    let mut line = vec![0.0; rows.len()];
+    let mut weight_line = weights.as_ref().map(|_| vec![0.0; rows.len()]);
+    for i in 0..rows[0].len() {
+        for (k, row) in rows.iter().enumerate() { line[k] = row[i]; }
+        if let (Some(rows), Some(line)) = (&weights, &mut weight_line) {
+            for (k, row) in rows.iter().enumerate() { line[k] = row[i]; }
+        }
+        filter_line_parallel(&mut line, weight_line.as_deref_mut(), size, masked, reverse);
+        for (k, row) in rows.iter_mut().enumerate() { row[i] = line[k]; }
+        if let (Some(rows), Some(line)) = (&mut weights, &weight_line) {
+            for (k, row) in rows.iter_mut().enumerate() { row[i] = line[k]; }
+        }
+    }
+}
