+#[cfg(all(test, feature = "parallel"))]
+mod parallel_filter_tests {
+    use super::*;
+
+    #[test]
+    fn parallel_smoothing_preserves_serial_values_and_weights() {
+        for threads in [1, 4] {
+        let pool = rayon::ThreadPoolBuilder::new().num_threads(threads).build().unwrap();
+        pool.install(|| {
+        for dims in [(0, 7, 9), (1, 7, 9), (9, 1, 11), (11, 7, 1), (21, 18, 17), (16, 32, 12)] {
+            let grid = Grid::new(dims.0, dims.1, dims.2, 0.4, 0.5, 0.6);
+            let n = grid.n_total();
+            let data: Vec<f64> = (0..n).map(|i| ((i * 37 % 101) as f64) / 17.0).collect();
+            let mask: Vec<u8> = (0..n).map(|i| u8::from(i % 13 != 0)).collect();
+            for masked in [false, true] {
+                for weighted in [false, true] {
+                    for nbox in [0, 1, 3, 4, 8] {
+                        let m = masked.then_some(mask.as_slice());
+                        let mut wa: Vec<f64> = (0..n).map(|i| 0.2 + (i % 7) as f64).collect();
+                        let mut wb = wa.clone();
+                        let a = gaussian_smooth_3d_impl(&data, [1.1, 1.7, 2.3], m,
+                            weighted.then_some(wa.as_mut_slice()), nbox, &grid, false);
+                        let b = gaussian_smooth_3d_impl(&data, [1.1, 1.7, 2.3], m,
+                            weighted.then_some(wb.as_mut_slice()), nbox, &grid, true);
+                        assert!(a.iter().zip(&b).all(|(x, y)| x.to_bits() == y.to_bits()));
+                        assert!(wa.iter().zip(&wb).all(|(x, y)| x.to_bits() == y.to_bits()));
+                    }
+                }
+            }
+        }
+        });
+        }
+    }
+}
