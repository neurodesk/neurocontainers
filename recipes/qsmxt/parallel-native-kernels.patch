+#[cfg(feature = "parallel")]
+fn filter_line_parallel(
+    line: &mut [f64], weight: Option<&mut [f64]>, size: usize,
+    masked: bool, reverse: bool,
+) {
+    if reverse { line.reverse(); }
+    if masked {
+        nan_box_filter_line(line, size);
+    } else if let Some(weight) = weight {
+        box_filter_line_weighted(line, weight, size);
+    } else {
+        box_filter_line(line, size);
+    }
+    if reverse { line.reverse(); }
+}
