+    #[test]
+    fn single_echo_handoff_requires_the_same_working_input_and_config() {
+        use super::*;
+        for case in ["original-only", "custom-mask", "negative", "disabled", "multi-echo"] {
+            let dir = tempfile::tempdir().unwrap();
+            let original = dir.path().join("original.nii");
+            let n = if case == "multi-echo" { 2 } else { 1 };
+            let run = run_with_echoes((0..n).map(|_| (
+                dir.path().join("phase.nii"), Some(original.clone()))).collect());
+            let output = crate::bids::derivatives::DerivativeOutputs::new(&dir.path().join("out"));
+            let mut meta = meta_4x4x4();
+            meta.n_echoes = n;
+            let mut cfg = PipelineConfig::default();
+            cfg.masking.inhomogeneity_correction = case != "disabled";
+            cfg.homogeneity.sigma_mm = 1.0;
+            if case == "custom-mask" { cfg.masking.custom_mask_tool = Some("external".into()); }
+            let mut state = PipelineState::new(&cfg, &run.key);
+            let state_path = dir.path().join("state.json");
+            let mut ctx = StageContext { run: &run, config: &cfg, output: &output,
+                meta: &meta, state: &mut state, state_path: &state_path };
+            let raw = vec![if case == "negative" { -10.0 } else { 10.0 }; 64];
+            save_volume(&original, &raw, &meta).unwrap();
+            if case != "original-only" {
+                for echo in 1..=n { save_volume(&output.mag_path(&run.key, echo), &raw, &meta).unwrap(); }
+            } else {
+                assert!(mask_echo_magnitudes(&ctx).unwrap().is_empty());
+            }
+            assert!(stage_magnitude(&mut ctx, &|_| {}).unwrap().is_none(), "case: {}", case);
+        }
+    }
