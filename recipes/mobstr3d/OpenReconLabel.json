  "parameters": [
    {
      "id": "config",
      "label": {
        "en": "config"
      },
      "type": "choice",
      "values": [
        {
          "id": "mobstr3d",
          "name": {
            "en": "mobstr3d"
          }
        }
      ],
      "default": "mobstr3d",
      "information": {
        "en": "Define the config to be executed by MRD server"
      }
    },
    {
      "id": "frameofseed",
      "label": {
        "en": "Seed frame"
      },
      "type": "int",
      "default": 5,
      "minimum": 0,
      "maximum": 99,
      "information": {
        "en": "First cardiac frame processed (zero-based). The unwrapping seed is selected on this frame. Earlier frames are skipped: modelESv2 is unreliable in early systole."
      }
    },
    {
      "id": "endframe",
      "label": {
        "en": "End frame"
      },
      "type": "int",
      "default": -1,
      "minimum": -1,
      "maximum": 99,
      "information": {
        "en": "Last cardiac frame processed (zero-based); -1 processes to the last acquired frame. Use it to drop late frames with faded signal."
      }
    },
    {
      "id": "phasequality",
      "label": {
        "en": "Phase quality"
      },
      "type": "choice",
      "values": [
        {
          "id": "cropped",
          "name": {
            "en": "cropped (DENSEanalysis)"
          }
        },
        {
          "id": "masked",
          "name": {
            "en": "masked"
          }
        }
      ],
      "default": "cropped",
      "information": {
        "en": "Phase quality map ordering the flood-fill unwrap: cropped matches DENSEanalysis; masked uses only in-mask neighbours."
      }
    },
    {
      "id": "contourmethod",
      "label": {
        "en": "Contour method"
      },
      "type": "choice",
      "values": [
        {
          "id": "marching_squares",
          "name": {
            "en": "marching squares"
          }
        },
        {
          "id": "cv2_find_contours",
          "name": {
            "en": "OpenCV findContours"
          }
        }
      ],
      "default": "marching_squares",
      "information": {
        "en": "Method used to turn the labels into endocardial and epicardial contours."
      }
    },
    {
      "id": "sendoriginal",
      "label": {
        "en": "Send original images"
      },
      "type": "boolean",
      "default": true,
      "information": {
        "en": "Also return the received magnitude and phase images."
      }
    }
  ]
}
