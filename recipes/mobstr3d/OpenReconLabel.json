{
  "general": {
    "name": {
      "en": "mobstr3d"
    },
    "version": "VERSION_WILL_BE_REPLACED_BY_SCRIPT",
    "vendor": "neurodesk",
    "information": {
      "en": "mobstr3D single-slice cine DENSE preprocessing: nnU-Net myocardial segmentation and spatiotemporal phase unwrapping of each slice as it is acquired. Returns the labels with endo/epicardial contours and x/y/z displacement maps in mm."
    },
    "id": "mobstr3d",
    "regulatory_information": {
      "device_trade_name": "mobstr3d",
