    {
      "id": "trajectoryfile",
      "label": { "en": "Bundled trajectory" },
      "type": "choice",
      "values": [
        {
          "id": "/opt/sodiumgridding_ptpi/23Na_pTPI_n28_g50_p5traj.h5",
