        "python=3.11"
      ]
    ],
    "files": [],
    "suite_replacements": [
      [
        "Python 3.9",
        "Python 3.11"
      ],
      [
        "tests:\n",
        "tests:\n  - name: PalmettoBUG software version and launcher\n    description: Verify the selected upstream distribution exposes its GUI command.\n    command: >-\n      python3 -c 'import importlib.metadata as m; import palmettobug;\n      d = m.distribution(\"palmettobug\");\n      assert d.version == \"${upstream_version}\";\n      assert any(e.name == \"palmettobug\" for e in d.entry_points)'\n    expected_exit_code: 0\n\n"
      ],
      [
        "\"bash -lc 'ls /opt/miniconda-latest/lib/python3.9/site-packages/palmettobug/'\"",
        ">\n      python3 -c 'import importlib.util; from pathlib import Path;\n      p = Path(importlib.util.find_spec(\"palmettobug\").origin).parent;\n      assert (p / \"Executable.py\").is_file(); print(\"Executable.py\")'"
      ]
    ],
    "suite_scalars": {
      "upstream_version": "0.2.11"
    },
    "container_version": "0.0.3.post1",
    "replace_run_group": {
      "contains": "cp {{ get_file(\"HARMONI_main_250424_zip\") }} HARMONI-main-250424.zip",
      "commands": [
        "pip install --no-cache-dir \"setuptools<81\" palmettobug=={{ context.upstream_version }}"
      ]
    },
    "remove_files": [
      "HARMONI_main_250424_zip"
    ],
    "evidence": {
      "old_software_version": "0.1.9",
      "old_sha256": "625d6f1b424d2733541b25e727a93a6491bc98ede02a081153a3d8067ecabdea",
      "reason": "The dated archive embeds palmettobug 0.1.9 and identifies BenCaiello/PalmettoBUG as upstream. The maintained release registry has no 0.1.9 release. Migrate explicitly to official 0.2.11 with supported Python 3.11."
    }
  },
